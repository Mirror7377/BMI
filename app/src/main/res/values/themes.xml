<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BMI" parent="Theme.MaterialComponents.DayNight.NoActionBar"/>
    <style name="Theme.BMI" parent="Base.Theme.BMI" />
    <style name="Theme.BMI.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@color/splash_blue</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
    </style>
    <style name="RoundedImageView12dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ThemeOverlay.NumberPicker" parent="Theme.AppCompat.Light">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
    </style>

    <!-- BottomSheet Dialog Theme -->
    <style name="Theme.BMI.BottomSheetDialog"
        parent="ThemeOverlay.Material3.BottomSheetDialog">

        <item name="bottomSheetStyle">@style/Widget.BMI.BottomSheet</item>

    </style>


    <!-- BottomSheet 本体 -->
    <style name="Widget.BMI.BottomSheet"
        parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <!-- 使用自己的 Shape -->
        <item name="shapeAppearance">@style/ShapeAppearance.BMI.BottomSheet</item>
        <!-- 不要阴影 -->
        <item name="android:elevation">0dp</item>
    </style>


    <!-- Shape -->
    <style name="ShapeAppearance.BMI.BottomSheet"
        parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>