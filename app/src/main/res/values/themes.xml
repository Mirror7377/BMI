<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App 全局 Theme -->
    <style name="Base.Theme.BMI"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:statusBarColor">@color/bg_gray</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <style name="Theme.BMI"
        parent="Base.Theme.BMI" />


    <!-- Splash -->
    <style name="Theme.BMI.Splash"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:navigationBarColor">@color/splash_blue</item>

        <item
            name="android:enforceNavigationBarContrast"
            tools:targetApi="29">false</item>

        <item name="android:windowBackground">
            @android:color/transparent
        </item>

        <item
            name="android:windowSplashScreenAnimatedIcon"
            tools:targetApi="31">
            @android:color/transparent
        </item>

        <item
            name="android:windowSplashScreenAnimationDuration"
            tools:targetApi="31">
            0
        </item>

    </style>


    <!-- 保留：项目中仍然有布局使用 -->
    <style name="RoundedImageView12dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


    <!-- BottomSheet Dialog -->
    <style name="Theme.BMI.BottomSheetDialog"
        parent="ThemeOverlay.Material3.BottomSheetDialog">

        <item name="bottomSheetStyle">
            @style/Widget.BMI.BottomSheet
        </item>

    </style>


    <!-- BottomSheet 本体 -->
    <style name="Widget.BMI.BottomSheet"
        parent="Widget.Material3.BottomSheet.Modal">

        <item name="backgroundTint">
            @android:color/transparent
        </item>

        <item name="shapeAppearance">
            @style/ShapeAppearance.BMI.BottomSheet
        </item>

        <item name="android:elevation">0dp</item>

    </style>


    <!-- BottomSheet Shape -->
    <style name="ShapeAppearance.BMI.BottomSheet"
        parent="ShapeAppearance.Material3.LargeComponent">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>

    </style>

</resources>